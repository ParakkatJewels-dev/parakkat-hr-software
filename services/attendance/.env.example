# ---------------------------------------------------------------------------
# Database — the same Supabase Postgres the web app uses.
# Dashboard -> Connect -> Session pooler (port 5432). Not the transaction pooler
# on 6543: Prisma needs prepared statements.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# BioTime — the device layer. REST API only; never touch its database.
# ---------------------------------------------------------------------------
BIOTIME_BASE_URL="http://192.168.1.50:8090"
BIOTIME_USERNAME="admin"
BIOTIME_PASSWORD="change-me"

# The timezone BioTime reports punch_time in. BioTime returns a NAIVE local string
# ("2026-07-23 09:15:32") with no offset, so this must match the BioTime server's
# clock or every punch lands hours off. Verify with `npm run doctor`.
BIOTIME_TIMEZONE="Asia/Kolkata"

# Optional: force one auth mode instead of probing. token | jwt | auto
BIOTIME_AUTH_MODE="auto"
BIOTIME_TIMEOUT_MS=30000
BIOTIME_MAX_RETRIES=4
BIOTIME_PAGE_SIZE=500

# ---------------------------------------------------------------------------
# Business timezone. All work_dates, shift boundaries and reports use this.
# ---------------------------------------------------------------------------
APP_TIMEZONE="Asia/Kolkata"

# ---------------------------------------------------------------------------
# Scheduling (node-cron expressions)
# ---------------------------------------------------------------------------
# Punch pull — every 2 minutes.
SYNC_TRANSACTIONS_CRON="*/2 * * * *"
# Employee + device roster — daily at 01:15 IST.
SYNC_EMPLOYEES_CRON="15 1 * * *"
# Nightly re-processing of the trailing window (catches late uploads).
ENGINE_CRON="30 2 * * *"
# How many days back the nightly engine re-processes.
ENGINE_LOOKBACK_DAYS=3
# Re-query window overlap, in minutes. Guards against punches sharing a boundary
# second with the previous batch. The unique constraint absorbs the repeats.
SYNC_OVERLAP_MINUTES=5

# Two punches from the same person closer together than this are one punch
# (double-tap on the terminal).
PUNCH_DEDUPE_SECONDS=60

# ---------------------------------------------------------------------------
# API (recompute triggers, exports, health)
# ---------------------------------------------------------------------------
API_PORT=8091
API_CORS_ORIGINS="http://localhost:5173,capacitor://localhost,http://localhost"

# Used to verify the caller's Supabase JWT and read their permissions.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="eyJ..."

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="development"
# Set false to run the API without the cron workers (e.g. a second replica).
ENABLE_WORKERS=true
