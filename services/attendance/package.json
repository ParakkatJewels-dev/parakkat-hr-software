{
  "name": "parakkat-attendance-service",
  "version": "1.0.0",
  "private": true,
  "description": "BioTime sync worker + attendance engine + reporting API for Parakkat HRMS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "sync:once": "tsx src/scripts/syncOnce.ts",
    "sync:employees": "tsx src/scripts/syncOnce.ts --employees",
    "backfill": "tsx src/scripts/backfill.ts",
    "recompute": "tsx src/scripts/recompute.ts",
    "seed": "tsx src/scripts/seed.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "test": "tsx --test --experimental-test-module-mocks src",
    "probe:rules": "tsx src/scripts/probeRules.ts",
    "shift:from-device": "tsx src/scripts/shiftFromDevice.ts",
    "fetch:all": "tsx src/scripts/fetchAll.ts",
    "reset:from-device": "tsx src/scripts/resetFromDevice.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
