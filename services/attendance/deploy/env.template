# Attendance service settings - TEMPLATE, with no passwords in it.
# On the first run the installer (Install.bat -> deploy/windows/setup.ps1) copies this file to .env
# and asks for the values marked FILL_ME: the Easy Time Pro username and password, and the
# database password. The real .env stays on the machine; it is never in a download or in git.

# Database - the same Supabase Postgres the web app uses.
# Dashboard -> Connect -> Session pooler (port 5432). Not the transaction pooler
# on 6543: Prisma needs prepared statements.
DATABASE_URL="postgresql://postgres.vdldanjglxoanduqytcl:FILL_ME@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?connection_limit=4&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://postgres.vdldanjglxoanduqytcl:FILL_ME@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?connection_limit=4&pool_timeout=20"

# Easy Time Pro (ZKTeco - same API as BioTime, hence the BIOTIME_ variable names).
# Use the SAME address HR opens in the browser, without the /login part.
# Example: if HR visits http://192.168.1.45:8081/login/?next=/ the base URL is
# http://192.168.1.45:8081 - or http://127.0.0.1:8081 when this service runs on
# the same machine as Easy Time Pro (recommended: survives router IP changes).
BIOTIME_BASE_URL="http://127.0.0.1:8081"
BIOTIME_USERNAME="FILL_ME"
BIOTIME_PASSWORD="FILL_ME"
# The timezone Easy Time Pro reports punch_time in (it returns a naive local string
# like "2026-07-23 09:15:32"). Must match that server's clock; verify with `npm run doctor`.
BIOTIME_TIMEZONE="Asia/Kolkata"
# Force one auth mode instead of probing: token | jwt | auto
BIOTIME_AUTH_MODE="auto"
BIOTIME_TIMEOUT_MS=30000
BIOTIME_MAX_RETRIES=4
BIOTIME_PAGE_SIZE=500

# Business timezone. All work_dates, shift boundaries and reports use this.
APP_TIMEZONE="Asia/Kolkata"

# Scheduling (node-cron expressions)
SYNC_TRANSACTIONS_CRON="*/2 * * * *"
SYNC_EMPLOYEES_CRON="*/5 * * * *"
ENGINE_CRON="30 2 * * *"
ENGINE_LOOKBACK_DAYS=3
SYNC_OVERLAP_MINUTES=5
PUNCH_DEDUPE_SECONDS=60

# How far back the FIRST EVER sync reaches (there is no cursor yet). Older punches are not
# imported automatically - use `npm run backfill -- --from=YYYY-MM-DD` for history.
INITIAL_SYNC_LOOKBACK_DAYS=7
# Safety valve per run: 40 pages x 500 records. A long outage drains over several runs.
SYNC_MAX_PAGES_PER_RUN=40
# Window the periodic catch-up re-reads, to pick up punches uploaded late by a terminal.
SYNC_CATCHUP_DAYS=3

# API (recompute triggers, exports, health)
API_PORT=8091
# Exact origins or wildcards (https://*.vercel.app covers preview deploys). Add your production
# web app URL here if it changes.
API_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost,https://parakkat-hr.vercel.app,https://*.vercel.app"

# Used to verify the caller's Supabase JWT and read their permissions.
