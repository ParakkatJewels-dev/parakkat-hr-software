{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "process": "readonly"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["backend/scripts/**/*.js"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["backend/supabase/functions/**/*.ts"],
      "globals": {
        "Deno": "readonly"
      }
    }
  ]
}
