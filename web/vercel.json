{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/directory", "destination": "/index.html" },
    { "source": "/directory/:path*", "destination": "/index.html" },
    { "source": "/employee-import", "destination": "/index.html" },
    { "source": "/employee-import/:path*", "destination": "/index.html" },
    { "source": "/organization", "destination": "/index.html" },
    { "source": "/organization/:path*", "destination": "/index.html" },
    { "source": "/recruitment", "destination": "/index.html" },
    { "source": "/recruitment/:path*", "destination": "/index.html" },
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/onboarding/:path*", "destination": "/index.html" },
    { "source": "/documents", "destination": "/index.html" },
    { "source": "/documents/:path*", "destination": "/index.html" },
    { "source": "/attendance", "destination": "/index.html" },
    { "source": "/attendance/:path*", "destination": "/index.html" },
    { "source": "/attendance-person", "destination": "/index.html" },
    { "source": "/attendance-person/:path*", "destination": "/index.html" },
    { "source": "/attendance-admin", "destination": "/index.html" },
    { "source": "/attendance-admin/:path*", "destination": "/index.html" },
    { "source": "/leave", "destination": "/index.html" },
    { "source": "/leave/:path*", "destination": "/index.html" },
    { "source": "/payroll", "destination": "/index.html" },
    { "source": "/payroll/:path*", "destination": "/index.html" },
    { "source": "/expense", "destination": "/index.html" },
    { "source": "/expense/:path*", "destination": "/index.html" },
    { "source": "/tasks", "destination": "/index.html" },
    { "source": "/tasks/:path*", "destination": "/index.html" },
    { "source": "/performance", "destination": "/index.html" },
    { "source": "/performance/:path*", "destination": "/index.html" },
    { "source": "/assets", "destination": "/index.html" },
    { "source": "/assets/:path*", "destination": "/index.html" },
    { "source": "/helpdesk", "destination": "/index.html" },
    { "source": "/helpdesk/:path*", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/reports/:path*", "destination": "/index.html" },
    { "source": "/administration", "destination": "/index.html" },
    { "source": "/administration/:path*", "destination": "/index.html" },
    { "source": "/admin-roles", "destination": "/index.html" },
    { "source": "/admin-roles/:path*", "destination": "/index.html" },
    { "source": "/admin-audit", "destination": "/index.html" },
    { "source": "/admin-audit/:path*", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/settings/:path*", "destination": "/index.html" }
  ]
}
