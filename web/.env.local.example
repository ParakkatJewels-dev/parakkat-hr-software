# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser.
#
# These are PUBLIC keys. The anon key is safe to ship — Row-Level Security is what protects the
# data, not the key. Never put the service_role key in this file: it bypasses RLS entirely.

VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# The attendance service (services/attendance). Used for recompute, device-code mapping and Excel
# exports; everything else reads straight from Supabase. If it is not running, those specific
# actions show an error and the rest of the app is unaffected.
VITE_ATTENDANCE_API_URL="http://localhost:8091"
